<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/run/current-system/sw/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>net.constella.testnet.runtime</string>
	<key>LimitLoadToSessionType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/Users/cd/constella-release-gate/deploy/testnet-mini/start.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/cd/constella-release-gate/runtime.log</string>
	<key>StandardOutPath</key>
	<string>/Users/cd/constella-release-gate/runtime.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
