# Private operator copy: production.env (chmod 600), never commit it.
# These images must be loaded from the tested release bundle, not rebuilt here.
NODE_IMAGE=constella:lightsail-testnet-20261001
EXPLORER_IMAGE=constella-explorer:lightsail-testnet-20261001
POSTGRES_IMAGE=postgres:16-alpine

# Conservative initial caps for the dedicated 4 GB testnet host.
# 2 vCPU inventory confirmed; all limits need a live capacity check.
# Leave explicit headroom for the host, proxy, backups and catch-up tuning.
NODE_CPUS=0.50
NODE_MEMORY=384m
POSTGRES_CPUS=0.25
POSTGRES_MEMORY=384m
EXPLORER_CPUS=0.50
EXPLORER_MEMORY=640m

# Generate 32 random bytes as hex; hex is safe inside the database URI.
POSTGRES_PASSWORD=

P2P_BIND=0.0.0.0
P2P_PORT=7043
EXPLORER_HTTP_PORT=3071
NODE_ADVERTISE=
# Reachable public/VPN bootstrap endpoints only, never an unreachable LAN IP.
# Empty uses the legacy built-in DNS seed. An inbound homelab peer can seed
# the node; validate that connection before declaring the deployment healthy.
NODE_PEERS=
