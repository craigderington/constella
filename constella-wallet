#!/bin/sh
# Source checkout launcher. Installed releases are the native binary itself.
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for binary in "$base/wallet/target/x86_64-unknown-linux-musl/release/constella-wallet" "$base/wallet/target/release/constella-wallet"; do
    if [ -x "$binary" ]; then exec "$binary" "$@"; fi
done
echo 'Build the wallet first: make wallet' >&2
exit 1
